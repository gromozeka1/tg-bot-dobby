# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Your numeric Telegram id, for error reports (optional)
ADMIN_TG_ID=

# SQLite database (relative paths are resolved from the project root)
DATABASE_URL=sqlite+aiosqlite:///./data/dobby.sqlite3

# Defaults for new users
DEFAULT_LOCALE=ru
DEFAULT_TZ=Europe/Minsk
DEFAULT_DIGEST_TIME=09:00

# INFO / DEBUG
LOG_LEVEL=INFO
